{
  "name": "dsh-better-chat-history",
  "version": "0.3.1",
  "description": "更好的聊天记录加载 —— DeepSeek Harness 会话 I/O 优化插件。兼容 DSH 0.2.2-rc.3+：包装 sessionPersistence.open() 的只读路径，用 revision 校验的 LRU 读缓存消除切换会话时的 JSONL 全量冷读（zstd 逐帧解压 + JSON 解析）。自带设置面板。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  }
}
